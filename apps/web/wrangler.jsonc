{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-emulator",
  "account_id": "ca84c3344d0e4226633468f23f8bcb77",
  "compatibility_date": "2026-05-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "api-emulator.jsj.sh",
      "custom_domain": true
    }
  ]
}
